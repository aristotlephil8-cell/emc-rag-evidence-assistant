# Copy to .env and provide secrets locally. Never commit .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3-rerank
GENERATION_MODEL=qwen3.7-plus-2026-05-26
ELASTICSEARCH_URL=http://elasticsearch:9200
CVRAG_DATABASE_URL=sqlite:////app/data/runtime/cvrag.db
CVRAG_MODEL_DIR=/app/models/deepdoc
CVRAG_REQUIRE_EVALUATION_LOCK=true
